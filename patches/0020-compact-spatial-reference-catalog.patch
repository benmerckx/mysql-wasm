--- /dev/null
+++ b/scripts/mysql_wasm_filter_srs.pl
@@ -0,0 +1,23 @@
+use strict;
+use warnings;
+
+my ($input, $output) = @ARGV;
+open my $source, '<:raw', $input or die "Cannot read $input: $!";
+my %retained = map { $_ => 0 } (3857, 4326);
+my @sql;
+while (my $line = <$source>) {
+    if ($line =~ /^REPLACE INTO mysql\.st_spatial_reference_systems\(/) {
+        $line =~ /\) VALUES \((\d+),.*;\s*$/ or die "Unexpected spatial reference row in $input";
+        my $id = $1;
+        next unless exists $retained{$id};
+        $retained{$id}++;
+    }
+    push @sql, $line;
+}
+for my $id (sort keys %retained) {
+    die "Expected one row for SRID $id in $input" unless $retained{$id} == 1;
+}
+
+open my $target, '>:raw', $output or die "Cannot write $output: $!";
+print {$target} @sql or die "Cannot write $output: $!";
+close $target or die "Cannot finish writing $output: $!";
