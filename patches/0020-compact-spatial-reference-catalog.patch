+    SET(filter_srs "${CMAKE_CURRENT_SOURCE_DIR}/mysql_wasm_filter_srs.pl")
+    SET(compact_sql "${CMAKE_CURRENT_BINARY_DIR}/${system_data}.sql")
+    ADD_CUSTOM_COMMAND(
+      OUTPUT "${compact_sql}"
+      COMMAND "${PERL_EXECUTABLE}" "${filter_srs}"
+              "${${system_data}_sql}" "${compact_sql}"
+      DEPENDS "${filter_srs}" "${${system_data}_sql}"
+      VERBATIM
+    )
+    SET(${system_data}_sql "${compact_sql}")
+  ENDIF()
+ENDFOREACH()
