+# Keep compact bootstrap inputs separate from the upstream SQL files.
+FOREACH(system_data mysql_system_tables_data mysql_system_tables_data_fix)
+  SET(${system_data}_sql "${CMAKE_CURRENT_SOURCE_DIR}/${system_data}.sql")
+  IF(EMSCRIPTEN)
