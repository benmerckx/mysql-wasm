--- a/config.h.cmake
+++ b/config.h.cmake
@@ -365,6 +365,6 @@
 #cmakedefine SASL_CLIENT_DONE_SUPPORTED @SASL_CLIENT_DONE_SUPPORTED@
 
 /* mysql native password support */
-#cmakedefine WITHOUT_MYSQL_NATIVE_PASSWORD @WITHOUT_MYSQL_NATIVE_PASSWORD@
+#cmakedefine01 WITHOUT_MYSQL_NATIVE_PASSWORD
 
 #endif
--- a/sql-common/client.cc
+++ b/sql-common/client.cc
@@ -5756,9 +5756,21 @@
         If everything else fail we use the built in plugin: caching sha if the
         server is new enough or native if not.
       */
+#if defined(WITHOUT_MYSQL_NATIVE_PASSWORD) && WITHOUT_MYSQL_NATIVE_PASSWORD == 1
+      if (!(mysql->server_capabilities & CLIENT_PLUGIN_AUTH)) {
+        set_mysql_extended_error(mysql, CR_AUTH_PLUGIN_CANNOT_LOAD,
+                                 unknown_sqlstate,
+                                 ER_CLIENT(CR_AUTH_PLUGIN_CANNOT_LOAD),
+                                 MYSQL_NATIVE_PASSWORD_PLUGIN_NAME,
+                                 "plugin not available");
+        return STATE_MACHINE_FAILED;
+      }
+      ctx->auth_plugin = &caching_sha2_password_client_plugin;
+#else
       ctx->auth_plugin = (mysql->server_capabilities & CLIENT_PLUGIN_AUTH)
                              ? &caching_sha2_password_client_plugin
                              : &native_password_client_plugin;
+#endif
       ctx->auth_plugin_name = ctx->auth_plugin->name;
     }
   }
