{
  "name": "mysql-wasm",
  "version": "0.2.1",
  "description": "MySQL Community Server 8.4 compiled to WebAssembly",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./src/browser.d.ts",
        "import": "./src/browser.mjs"
      },
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./process": {
      "types": "./src/process.d.ts",
      "import": "./src/process.mjs"
    }
  },
  "files": [
    "src",
    "dist/mysqld.wasm",
    "dist/runtime_output_directory/*.js",
    "dist/runtime_output_directory/package.json",
    "dist/assets.data",
    "dist/datadir.data",
    "dist/browser/*.js",
    "dist/licenses"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/check-package.mjs",
    "bench": "node bench/node.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmerckx/mysql-wasm.git"
  },
  "license": "GPL-2.0-only",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17"
  }
}
