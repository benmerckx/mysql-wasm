#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
source_dir="${MYSQL_WASM_SOURCE_DIR:-$("$root/scripts/prepare-source")}"
build_dir="${MYSQL_WASM_BUILD_DIR:-$root/build/emscripten/$(basename "$source_dir")}"
dist="$root/dist"

# Bun gives worker threads a web postMessage, so Emscripten skips the shim
# that delivers parentPort messages and its threads never start.
stage_js() {
  perl -0pe 's/globalThis\.postMessage\|\|\(/(/ or die "Missing the pthread message shim\n"' \
    "$build_dir/runtime_output_directory/mysqld.js" > "$1/mysqld.js"
}

if [[ "${1:-}" == --browser ]]; then
  mkdir -p "$dist/browser"
  if ! cmp -s "$build_dir/runtime_output_directory/mysqld.wasm" "$dist/mysqld.wasm"; then
    echo 'Stage the matching Node build before the browser build.' >&2
    exit 1
  fi
  stage_js "$dist/browser"
  exit
fi

mkdir -p "$dist/runtime_output_directory" "$dist/share/english" "$dist/lib/private"
stage_js "$dist/runtime_output_directory"
cp "$build_dir/runtime_output_directory/mysqld.wasm" "$dist/"
printf '{"type":"commonjs"}\n' > "$dist/runtime_output_directory/package.json"
cp "$build_dir/share/english/errmsg.sys" "$dist/share/english/"
cp -R "$source_dir/share/charsets" "$dist/share/"
# Stage the ICU resources opened by the regex engine.
icu_dir="$dist/lib/private/icudt77l"
rm -rf -- "$icu_dir"
while IFS= read -r file; do
  mkdir -p "$(dirname "$icu_dir/$file")"
  cp "$source_dir/extra/icu/icudt77l/$file" "$icu_dir/$file"
done < "$root/scripts/icu-regex-assets.txt"
node "$root/scripts/pack-assets.mjs" "$dist" "$source_dir" "$build_dir"
# MySQL refuses the template's lower_case_table_names=0 on a case-insensitive
# build host, so this step needs a case-sensitive TMPDIR.
node "$root/scripts/make-datadir.mjs" "$dist"

mkdir -p "$dist/licenses"
cp "$source_dir/LICENSE" "$dist/licenses/mysql-server.txt"
cp "${OPENSSL_SOURCE_DIR:-$root/build/openssl}/LICENSE.txt" "$dist/licenses/openssl.txt"
