#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v emcmake >/dev/null 2>&1; then
  echo 'Activate the Emscripten SDK before running this probe.' >&2
  exit 1
fi

ssl="${OPENSSL_WASM_ROOT:-$root/build/openssl-wasm32}"
comp_err="${MYSQL_WASM_COMP_ERR:-$root/build/native/runtime_output_directory/comp_err}"
if [[ ! -f "$ssl/lib/libssl_stubs.a" || ! -f "$ssl/lib/libcrypto.a" || ! -x "$comp_err" ||
      ! -x "$(dirname "$comp_err")/uca9dump" ||
      ! -x "$(dirname "$comp_err")/comp_sql" ]]; then
  echo 'Build target OpenSSL and the native generators with ./scripts/build-dependencies.' >&2
  exit 1
fi

source_dir="$("$root/scripts/prepare-source")"
build_dir="$root/build/emscripten/$(basename "$source_dir")"
# Emscripten's Node-run code generators are CommonJS.
mkdir -p "$build_dir"
printf '{"type":"commonjs"}\n' > "$build_dir/package.json"
exec emcmake cmake -S "$source_dir" -B "$build_dir" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_FLAGS="-pthread" \
  -DCMAKE_CXX_FLAGS="-pthread -fwasm-exceptions" \
  -DCMAKE_C_FLAGS_RELEASE="-Oz -DNDEBUG" \
  -DCMAKE_CXX_FLAGS_RELEASE="-Oz -DNDEBUG" \
  -DMYSQL_WASM_COMP_ERR="$comp_err" \
  -DWITH_SSL="$ssl" \
  -DOPENSSL_ROOT_DIR="$ssl" \
  -DOPENSSL_INCLUDE_DIR="$ssl/include" \
  -DOPENSSL_LIBRARY="$ssl/lib/libssl_stubs.a" \
  -DCRYPTO_LIBRARY="$ssl/lib/libcrypto.a" \
  -DCMAKE_EXE_LINKER_FLAGS="-Oz -sNODERAWFS=1 -sALLOW_MEMORY_GROWTH=1" \
  -Dprotobuf_BUILD_SHARED_LIBS=OFF \
  -DWITH_NDBCLUSTER_STORAGE_ENGINE=OFF \
  -DWITH_PERFSCHEMA_STORAGE_ENGINE=OFF \
  -DDISABLE_ALL_PSI=ON \
  -DWITHOUT_ARCHIVE_STORAGE_ENGINE=ON \
  -DWITHOUT_BLACKHOLE_STORAGE_ENGINE=ON \
  -DWITHOUT_FEDERATED_STORAGE_ENGINE=ON \
  -DWITH_NGRAM_PARSER=OFF \
  -DWITHOUT_MYSQL_NATIVE_PASSWORD=ON \
  -DWITH_MYSQLX=OFF \
  -DWITHOUT_GROUP_REPLICATION=ON \
  -DWITH_ROUTER=OFF \
  -DWITH_UNIT_TESTS=OFF \
  "$@"
