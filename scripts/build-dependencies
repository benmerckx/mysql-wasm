#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
upstream="$root/upstream/mysql-server"
if [[ ! -f "$upstream/CMakeLists.txt" ]]; then
  echo 'Initialize MySQL with git submodule update --init first.' >&2
  exit 1
fi
if ! command -v emcc >/dev/null 2>&1; then
  echo 'Activate the Emscripten SDK before building dependencies.' >&2
  exit 1
fi

jobs="${JOBS:-4}"
native="$root/build/native"
openssl="$root/build/openssl"
prefix="$root/build/openssl-wasm32"

cmake -S "$upstream" -B "$native" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DWITHOUT_SERVER=ON -DWITH_ROUTER=OFF -DWITH_UNIT_TESTS=OFF \
  -DWITH_TIRPC=bundled -DWITH_CURL=none
cmake --build "$native" --target comp_err uca9dump comp_sql --parallel "$jobs"

if [[ ! -d "$openssl/.git" ]]; then
  git clone --depth 1 --branch openssl-3.5.9 https://github.com/openssl/openssl.git "$openssl"
fi
cd "$openssl"
# Only libcrypto is linked, for hashing, AES and random bytes. The default
# provider registers every algorithm it is built with, so unused ones go.
options=(
  -Oz -pthread no-asm no-shared no-tests no-module no-dso no-apps
  no-async no-afalgeng no-ktls no-quic no-err no-engine no-comp no-ocsp
  no-cms no-ts no-srp no-ct no-cmp no-dtls no-srtp no-ssl3 no-tls1 no-tls1_1
  no-psk no-idea no-camellia no-seed no-rc2 no-rc4 no-rc5 no-md4 no-mdc2
  no-whirlpool no-sm2 no-sm3 no-sm4 no-aria no-bf no-cast no-des no-dsa
  no-gost no-siphash no-ec2m no-scrypt no-ocb no-legacy no-ui-console no-http
  no-ssl-trace no-autoload-config no-padlockeng
)
# OpenSSL's make rules do not rebuild existing objects when options change.
stamp="$openssl/.mysql-wasm-options"
if [[ -f Makefile && "$(cat "$stamp" 2>/dev/null)" != "${options[*]}" ]]; then
  make clean
fi
CC=emcc CXX=em++ AR=emar RANLIB=emranlib ./Configure linux-generic32 \
  "${options[@]}" --prefix="$prefix" --libdir=lib
printf '%s' "${options[*]}" > "$stamp"
make -j"$jobs" build_sw
make install_sw

# The server's remaining TLS calls link against stubs instead of libssl.
emcc -Oz -pthread -Wall -Wno-unused-parameter -Werror \
  -I"$prefix/include" -c "$root/port/ssl_stubs.c" -o "$prefix/lib/ssl_stubs.o"
rm -f "$prefix/lib/libssl_stubs.a"
emar rcs "$prefix/lib/libssl_stubs.a" "$prefix/lib/ssl_stubs.o"
