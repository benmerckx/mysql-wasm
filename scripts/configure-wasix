#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
source_dir="$root/upstream/mysql-server"
compiler_dir="${WASIXCC_ROOT:-$HOME/.wasixcc}"

if [[ ! -f "$source_dir/CMakeLists.txt" ]]; then
  echo 'Initialize MySQL with git submodule update --init first.' >&2
  exit 1
fi
if [[ ! -x "$compiler_dir/bin/wasixcc" || ! -x "$compiler_dir/bin/wasixcc++" ]]; then
  echo "Install wasixcc or set WASIXCC_ROOT (checked $compiler_dir)." >&2
  exit 1
fi

exec cmake -S "$source_dir" -B "$root/build/wasix" -G Ninja \
  -DCMAKE_TOOLCHAIN_FILE="$root/cmake/wasix.cmake" \
  -DWASIXCC_ROOT="$compiler_dir" \
  -DCMAKE_BUILD_TYPE=Release \
  -DWITH_ROUTER=OFF \
  -DWITH_UNIT_TESTS=OFF \
  "$@"
